+// MiniLAN @feature Virtual-LAN VPNs (MiniLAN, Tailscale, ZeroTier) give each player an address in the
+// shared address space 100.64.0.0/10 on a tun interface. That tunnel *is* the LAN the players share, so list
+// it like Wi-Fi; other VPN tunnels (privacy VPNs) and mobile data (rmnet/ccmni, which may also use 100.64/10)
+// stay excluded. The list is sorted, so with a virtual LAN connected its 100.x address becomes the default.
+static bool isVirtualLanTunnel(const char *name, UnsignedInt hostAddr)
+{
+	return strncmp(name, "tun", 3) == 0 && (hostAddr & 0xFFC00000u) == 0x64400000u;
+}
